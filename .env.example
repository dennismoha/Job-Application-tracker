NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_intelligence?schema=public"
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=30

# Shared source scheduler / worker
SCHEDULER_ENABLED=false
SCHEDULER_TICK_MS=60000
WORKER_TICK_MS=2000
WORKER_ID=local-worker
RUN_STALE_MINUTES=15

# Import ownership for the research source registry
RESEARCH_SOURCE_OWNER_EMAIL=

# n8n sends alert emails to /api/email-ingestions/webhook with this header:
# x-ingestion-secret: <value>
N8N_INGESTION_SECRET=replace-with-at-least-16-random-characters

# Internet-wide search. The default endpoint is Serper's Google Search API.
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENDPOINT=https://google.serper.dev/search

# Optional AI intelligence. The implementation uses the Responses API shape.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-luna
AI_PROVIDER=openai
AI_DEDUP_ENABLED=false

# Original CV files are uploaded as authenticated Cloudinary assets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Per-process API safety limit. Put a reverse proxy / edge rate limiter in front
# of multiple API replicas in production.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=240

# Optional. If set, sharing one or more jobs posts an email payload here.
# Without it, JobIntel opens the user's local email client with a prepared message.
JOB_SHARE_WEBHOOK_URL=

GITHUB_TOKEN=ghp_
app=github_
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_PROJECT_NUMBER=
GITHUB_PROJECT_NODE_ID=PVT_