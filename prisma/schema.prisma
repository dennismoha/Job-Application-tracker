model Cv {
  id String @id @default(cuid())

  userId String
  name   String
  description String?

  isMaster Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions CvVersion[]
  profileLinks CvProfileLink[]

  @@index([userId, archived])
}

model CvVersion {
  id String @id @default(cuid())

  cvId String
  versionNumber Int
  label String?
  sourceType CvSourceType

  originalFileName String?
  mimeType String?
  originalFileData Bytes?
  cloudinaryPublicId String?

  plainText String
  structuredData Json?
  changeSummary String?

  createdAt DateTime @default(now())

  cv Cv @relation(fields: [cvId], references: [id], onDelete: Cascade)
  matches JobCvMatch[]
  baseTailoringSessions CvTailoringSession[] @relation("TailoringBaseVersion")
  createdFromTailoring CvTailoringSession? @relation("TailoringCreatedVersion")
  applications Application[]
  preferredByJobStates UserJobState[]

  @@unique([cvId, versionNumber])
  @@index([cvId, createdAt])
}

model CvAssetDeletion {
