  publicId String @unique
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nextAttemptAt, createdAt])
}

model CvProfileLink {
  id String @id @default(cuid())

  cvId String
  profileId String
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cv Cv @relation(fields: [cvId], references: [id], onDelete: Cascade)
  profile SearchProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([cvId, profileId])
  @@index([profileId, isDefault])
}

model JobRequirement {
  id String @id @default(cuid())

  jobId String
  kind CvRequirementKind
  text String
  normalizedKey String?
  priority Int @default(50)
  source String @default("JOB_DESCRIPTION")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchItems JobCvMatchItem[]

  @@index([jobId, kind])
  @@index([normalizedKey])
}

model JobCvMatch {
  id String @id @default(cuid())

  userId String
  jobId String
  cvVersionId String

  score Int
  summary String?

  evidencedCount Int @default(0)
  partialCount Int @default(0)
  notEvidencedCount Int @default(0)
  needsConfirmationCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cvVersion CvVersion @relation(fields: [cvVersionId], references: [id], onDelete: Cascade)
  items JobCvMatchItem[]
  tailoringSessions CvTailoringSession[]

  @@unique([userId, jobId, cvVersionId])
  @@index([jobId, updatedAt])
  @@index([cvVersionId])
}

model JobCvMatchItem {
  id String @id @default(cuid())

  matchId String
  requirementId String?
  requirementText String
  status CvMatchStatus
  evidence String?
  suggestion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match JobCvMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  requirement JobRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([matchId, status])
}

model CvTailoringSession {
  id String @id @default(cuid())

  userId String
  jobId String
  baseCvVersionId String
  matchId String?
  createdVersionId String? @unique

  status CvTailoringStatus @default(DRAFT)
  workingText String
  workingData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  baseCvVersion CvVersion @relation("TailoringBaseVersion", fields: [baseCvVersionId], references: [id], onDelete: Cascade)
  match JobCvMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  createdVersion CvVersion? @relation("TailoringCreatedVersion", fields: [createdVersionId], references: [id], onDelete: SetNull)
  suggestions CvTailoringSuggestion[]

  @@index([userId, updatedAt])
  @@index([jobId])
}

model CvTailoringSuggestion {
  id String @id @default(cuid())

  sessionId String
  requirementText String?
  section String?
  beforeText String?
  afterText String?
  reason String
  requiresConfirmation Boolean @default(false)
  confirmedFact String?
  status CvSuggestionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session CvTailoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
}

model AiUsage {
  id String @id @default(cuid())

  userId    String?
  profileId String?
  jobId     String?

  task     AiTaskType
  provider String
  model    String

  inputTokens  Int?
  outputTokens Int?
  estimatedCostUsd Decimal? @db.Decimal(12, 6)

  metadata Json?

  createdAt DateTime @default(now())

  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile SearchProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  job     Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([task, createdAt])
  @@index([userId, createdAt])
}

