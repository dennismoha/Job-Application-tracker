{
  "name": "job-intelligence-platform",
  "version": "1.10.0",
  "private": true,
  "description": "Personal job intelligence, source monitoring, deduplication, application tracking, and source analytics platform.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "worker:prod": "node dist/src/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "docs:dev": "vite --config docs/viewer/vite.config.ts",
    "docs:build": "vite build --config docs/viewer/vite.config.ts",
    "project:check": "node scripts/check-project.mjs && node scripts/check-v17-ui-shell.mjs",
    "research:import-sources": "tsx scripts/import-research-sources.ts",
    "extension:package": "tsx scripts/package-extension.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck",
    "web:lint": "npm --prefix web run lint",
    "quality": "npm run project:check && npm run typecheck && npm run lint && npm run format:check && npm test",
    "worker": "tsx src/worker.ts",   
    "ci": "npm run project:check && npm run db:generate && npm run typecheck && npm run lint && npm run format:check && npm test && npm run docs:build && npm run web:typecheck && npm run web:lint && npm run web:build",
    "ui:check": "node scripts/check-v17-ui-shell.mjs",
    "db:backfill-url-integrity": "tsx scripts/backfill-url-integrity.ts",
    "github:roadmap:validate": "node .github/project/push-project.mjs --validate",
    "github:roadmap:push": "node --env-file=.env .github/project/push-project.mjs",
    "github:roadmap:pull": "node --env-file=.env .github/project/pull-project.mjs",
    "github:roadmap:sync": "node --env-file=.env .github/project/sync-project.mjs",
    "github:roadmap:sync:dry": "node --env-file=.env .github/project/sync-project.mjs --dry-run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@prisma/client": "^6.16.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mammoth": "^1.9.1",
    "pdf-parse": "^1.1.1",
    "prisma": "^6.16.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "mermaid": "^11.11.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
