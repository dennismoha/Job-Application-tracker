{
  "manifest_version": 3,
  "name": "Job Intelligence Companion",
  "version": "1.3.0",
  "description": "Capture job pages, compare CVs, prepare truthful applications, and track applications in Job Intelligence.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "tabs",  
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:4000/*"
    // "https://job-application-tracker-k0jm.onrender.com"
  ],
  "action": {
    "default_title": "Save to Job Intelligence",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "split",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
